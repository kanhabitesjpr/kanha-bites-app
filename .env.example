# Copy this file to .env.local in your StackBlitz project.
# Use the Supabase Project URL and the publishable/anon public key only.
# NEVER put the Supabase service_role or secret key in a VITE_ variable.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_PUBLIC_KEY

